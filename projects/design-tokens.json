{
  "name": "santdev-black-editorial",
  "reference": "https://atrium-template.modulify.website/",
  "colors": {
    "background": "#080808",
    "surface": "#101112",
    "raised": "#17191b",
    "ink": "#f3f1eb",
    "muted": "#b9b9bb",
    "accent": "#9eafff"
  },
  "typography": {
    "display": "Barlow Condensed",
    "body": "Instrument Sans",
    "meta": "DM Mono"
  },
  "layout": {
    "maxWidth": "1480px",
    "gutter": "clamp(20px,4.2vw,66px)",
    "hero": "100svh",
    "scroll": "vertical"
  },
  "rules": [
    "No video",
    "No scroll hijacking",
    "No fake production metrics",
    "Use real work evidence",
    "Accessible controls and reduced motion"
  ]
}
